  "confirmed_findings": [
    {
      "priority": "P2",
      "kind": "test-compilation regression",
      "title": "New Unix descriptor tests break Solaris/illumos test compilation",
      "location": "sctp_unsupported_unix_test.go:1",
      "cause": "The !linux && !windows build condition includes Solaris and illumos, but the tests call syscall.Dup2, which is absent on these targets.",
      "evidence": "Go 1.26.10 and 1.27.2; Solaris/amd64 and illumos/amd64; three independent compilations per matrix cell. 0.7.1 test compilation passes, v0.7.2 fails with undefined: syscall.Dup2 at lines 34 and 68. Excluding only the new test file in a diagnostic archive restores test compilation.",
      "scope": "Production package go build passes on both revisions and targets. This is not a demonstrated Linux SCTP runtime regression.",
      "suggestion": "Limit these real SCTP/fd=0 tests to Linux/386, or supply platform-specific primitives and socket setup for additional targets.",
      "disposition": "deferred_out_of_scope",
      "release_blocking": false
    }
  ],
