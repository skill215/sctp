new file mode 100644
index 0000000..296149d
--- /dev/null
+++ b/diam/close_notify_test.go
@@ -0,0 +1,48 @@
+package diam_test
+
+import (
+	"net"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/ctrlzy/go-diameter/v4/diam"
+)
+
+func TestCloseNotifyLateConcurrentSubscribers(t *testing.T) {
+	local, remote := net.Pipe()
+	defer remote.Close()
+	mux := diam.NewServeMux()
+	c, err := diam.NewConn(local, "pipe", mux, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	c.Close()
+	select {
+	case <-mux.ErrorReports():
+	case <-time.After(time.Second):
+		t.Fatal("read loop did not process close")
+	}
+	channels := make(chan (<-chan struct{}), 32)
+	var wg sync.WaitGroup
+	for range 32 {
+		wg.Add(1)
+		go func() { defer wg.Done(); channels <- c.(diam.CloseNotifier).CloseNotify() }()
+	}
+	wg.Wait()
+	close(channels)
+	var first <-chan struct{}
+	for ch := range channels {
+		if first == nil {
+			first = ch
+		} else if first != ch {
+			t.Fatal("subscribers received different channels")
+		}
+		select {
+		case <-ch:
+		default:
+			t.Fatal("late subscriber missed completed disconnection")
+		}
+	}
+}
diff --git a/diam/deadline_error_test.go b/diam/deadline_error_test.go
new file mode 100644
index 0000000..e471477
--- /dev/null
+++ b/diam/deadline_error_test.go
@@ -0,0 +1,111 @@
+package diam
+
+import (
+	"errors"
+	"net"
+	"testing"
+	"time"
+)
+
+type deadlineProbeConn struct {
+	readCalls, writeCalls int
+	err                   error
+}
+
+func (c *deadlineProbeConn) Read([]byte) (int, error) {
+	c.readCalls++
+	return 0, errors.New("unexpected read")
+}
+func (c *deadlineProbeConn) Write(b []byte) (int, error)      { c.writeCalls++; return len(b), nil }
+func (c *deadlineProbeConn) Close() error                     { return nil }
+func (c *deadlineProbeConn) LocalAddr() net.Addr              { return &net.TCPAddr{} }
+func (c *deadlineProbeConn) RemoteAddr() net.Addr             { return &net.TCPAddr{} }
+func (c *deadlineProbeConn) SetDeadline(time.Time) error      { return c.err }
+func (c *deadlineProbeConn) SetReadDeadline(time.Time) error  { return c.err }
+func (c *deadlineProbeConn) SetWriteDeadline(time.Time) error { return c.err }
+
+type deadlineProbeMulti struct {
+	MultistreamConn
+	probe *deadlineProbeConn
+}
+
+func (c *deadlineProbeMulti) ReadAtLeast(b []byte, _ int, stream uint) (int, uint, error) {
+	n, err := c.probe.Read(b)
+	return n, stream, err
+}
+
+func (c *deadlineProbeMulti) Read(b []byte) (int, error)                { return c.probe.Read(b) }
+func (c *deadlineProbeMulti) Write(b []byte) (int, error)               { return c.probe.Write(b) }
+func (c *deadlineProbeMulti) WriteStream(b []byte, _ uint) (int, error) { return c.probe.Write(b) }
+func (c *deadlineProbeMulti) ResetCurrentStream()                       {}
+func (c *deadlineProbeMulti) SetReadDeadline(d time.Time) error         { return c.probe.SetReadDeadline(d) }
+func (c *deadlineProbeMulti) SetWriteDeadline(d time.Time) error        { return c.probe.SetWriteDeadline(d) }
+
+func TestDeadlineSetupFailureStopsIO(t *testing.T) {
+	for _, multi := range []bool{false, true} {
+		for _, op := range []string{"Read", "Write", "WriteStream"} {
+			name := map[bool]string{false: "single", true: "multi"}[multi] + "/" + op
+			t.Run(name, func(t *testing.T) {
+				want := errors.New("transport cannot configure deadline")
+				probe := &deadlineProbeConn{err: want}
+				var rw net.Conn = probe
+				if multi {
+					rw = &deadlineProbeMulti{probe: probe}
+				}
+				srv := &Server{ReadTimeout: time.Second, WriteTimeout: time.Second}
+				c, err := srv.newConn(rw)
+				if err != nil {
+					t.Fatal(err)
+				}
+				var n int
+				switch op {
+				case "Read":
+					_, err = c.readMessage()
+				case "Write":
+					n, err = c.writer.Write([]byte("payload"))
+				case "WriteStream":
+					n, err = c.writer.WriteStream([]byte("payload"), 1)
+				}
+				if !errors.Is(err, want) {
+					t.Errorf("error=%v, want original deadline error", err)
+				}
+				if n != 0 || probe.readCalls != 0 || probe.writeCalls != 0 {
+					t.Errorf("I/O after failed deadline: n=%d reads=%d writes=%d", n, probe.readCalls, probe.writeCalls)
+				}
+			})
+		}
+	}
+}
+
+func TestZeroTimeoutDoesNotConfigureDeadline(t *testing.T) {
+	for _, multi := range []bool{false, true} {
+		for _, op := range []string{"Read", "Write", "WriteStream"} {
+			t.Run(map[bool]string{false: "single", true: "multi"}[multi]+"/"+op, func(t *testing.T) {
+				probe := &deadlineProbeConn{err: errors.New("deadline must not be configured")}
+				var rw net.Conn = probe
+				if multi {
+					rw = &deadlineProbeMulti{probe: probe}
+				}
+				c, err := (&Server{}).newConn(rw)
+				if err != nil {
+					t.Fatal(err)
+				}
+				var n int
+				switch op {
+				case "Read":
+					_, err = c.readMessage()
+					if probe.readCalls != 1 {
+						t.Fatalf("reads=%d, err=%v", probe.readCalls, err)
+					}
+				case "Write":
+					n, err = c.writer.Write([]byte("payload"))
+				case "WriteStream":
+					n, err = c.writer.WriteStream([]byte("payload"), 1)
+				}
+				if op != "Read" && (err != nil || n != 7 || probe.writeCalls != 1) {
+					t.Fatalf("write n=%d err=%v calls=%d", n, err, probe.writeCalls)
+				}
+			})
+		}
+	}
+}
diff --git a/diam/sctp_dial_timeout_linux.go b/diam/sctp_dial_timeout_linux.go
new file mode 100644
index 0000000..63d3019
--- /dev/null
+++ b/diam/sctp_dial_timeout_linux.go
@@ -0,0 +1,51 @@
+//go:build linux && !386
+
+package diam
+
+import (
+	"errors"
+	"fmt"
+	"net"
+	"os"
+	"syscall"
+	"time"
+
+	"github.com/skill215/sctp"
+)
+
+func setSCTPConnectTimeout(raw syscall.RawConn, timeout time.Duration) error {
+	value := syscall.NsecToTimeval(timeout.Nanoseconds())
+	var optionErr error
+	if err := raw.Control(func(fd uintptr) {
+		optionErr = syscall.SetsockoptTimeval(int(fd), syscall.SOL_SOCKET, syscall.SO_SNDTIMEO, &value)
+	}); err != nil {
+		return err
+	}
+	return optionErr
+}
+
+// Limit association setup after address resolution. This is not a DNS or
+// context deadline. The relative timeout must be cleared before handing the
+// socket to callers so it does not impose a timeout on subsequent writes.
+func dialSCTPTimeout(network string, local, remote *sctp.SCTPAddr, cfg sctp.SocketConfig, timeout time.Duration) (*sctp.SCTPConn, error) {
+	if timeout == 0 {
+		return cfg.Dial(network, local, remote)
+	}
+	cfg.Control = func(_, _ string, raw syscall.RawConn) error { return setSCTPConnectTimeout(raw, timeout) }
+	conn, err := cfg.Dial(network, local, remote)
+	if err != nil {
+		if errors.Is(err, syscall.EINPROGRESS) {
+			return nil, &net.OpError{Op: "dial", Net: network, Addr: remote, Err: os.ErrDeadlineExceeded}
+		}
+		return nil, err
+	}
+	raw, err := conn.SyscallConn()
+	if err == nil {
+		err = setSCTPConnectTimeout(raw, 0)
+	}
+	if err != nil {
+		conn.Close()
+		return nil, fmt.Errorf("clear SCTP connect timeout: %w", err)
+	}
+	return conn, nil
+}
