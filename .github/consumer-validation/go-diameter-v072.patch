+//go:build linux && !386 && !android
+
+package sm_test
+
+import (
+	"bytes"
+	"fmt"
+	"net"
+	"os"
+	"runtime"
+	"strconv"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/ctrlzy/go-diameter/v4/diam"
+	"github.com/ctrlzy/go-diameter/v4/diam/avp"
+	"github.com/ctrlzy/go-diameter/v4/diam/datatype"
+	"github.com/ctrlzy/go-diameter/v4/diam/dict"
+	"github.com/ctrlzy/go-diameter/v4/diam/sm"
+	"syscall"
+)
+
+// Preserve MultistreamConn on accepted sockets while owning every test fd.
+type integrationListener struct {
+	net.Listener
+	mu       sync.Mutex
+	peers    map[net.Conn]struct{}
+	accepted chan net.Conn
+	stopped  chan struct{}
+	once     sync.Once
+}
+
+func (l *integrationListener) Accept() (net.Conn, error) {
+	c, err := l.Listener.Accept()
+	if err != nil {
+		return nil, err
+	}
+	l.mu.Lock()
+	select {
+	case <-l.stopped:
+		l.mu.Unlock()
+		c.Close()
+		return nil, net.ErrClosed
+	default:
+	}
+	l.peers[c] = struct{}{}
+	l.mu.Unlock()
+	select {
+	case l.accepted <- c:
+		return c, nil
+	case <-l.stopped:
+		c.Close()
+		return nil, net.ErrClosed
+	}
+}
+func (l *integrationListener) release(c net.Conn) {
+	c.Close()
+	l.mu.Lock()
+	delete(l.peers, c)
+	l.mu.Unlock()
+}
+func (l *integrationListener) Close() error {
+	var err error
+	l.once.Do(func() {
+		l.mu.Lock()
+		close(l.stopped)
+		err = l.Listener.Close()
+		for c := range l.peers {
+			c.Close()
+		}
+		l.peers = make(map[net.Conn]struct{})
+		l.mu.Unlock()
+	})
+	return err
+}
+func integrationServer(t *testing.T, h diam.Handler) *integrationListener {
+	t.Helper()
+	ln, err := diam.MultistreamListen("sctp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	l := &integrationListener{Listener: ln, peers: make(map[net.Conn]struct{}), accepted: make(chan net.Conn, 1), stopped: make(chan struct{})}
+	done := make(chan error, 1)
+	go func() { done <- (&diam.Server{Handler: h}).Serve(l) }()
+	t.Cleanup(func() {
+		l.Close()
+		select {
+		case <-done:
+		case <-time.After(time.Second):
+			t.Error("server accept loop did not stop")
+		}
+	})
+	return l
+}
+func integrationClient(watchdog bool) *sm.Client {
+	return &sm.Client{Handler: sm.New(&sm.Settings{OriginHost: "client", OriginRealm: "integration.test", VendorID: 13, ProductName: "sctp-integration"}), EnableWatchdog: watchdog, WatchdogInterval: 30 * time.Millisecond, WatchdogStream: 15, RetransmitInterval: 200 * time.Millisecond, AcctApplicationID: []*diam.AVP{diam.NewAVP(avp.AcctApplicationID, avp.Mbit, 0, datatype.Unsigned32(3))}}
+}
+func integrationMachine() *sm.StateMachine {
+	return sm.New(&sm.Settings{OriginHost: "server", OriginRealm: "integration.test", VendorID: 13, ProductName: "sctp-integration"})
+}
+func integrationDial(t *testing.T, cli *sm.Client, l *integrationListener) (diam.Conn, *diam.SCTPConn) {
+	t.Helper()
+	c, err := cli.DialExt("sctp4", l.Addr().String(), time.Second, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(c.Close)
+	select {
+	case peer := <-l.accepted:
+		return c, peer.(*diam.SCTPConn)
+	case <-time.After(time.Second):
+		t.Fatal("no accepted socket")
+		return nil, nil
+	}
+}
+func integrationClosed(t *testing.T, c diam.Conn) {
+	t.Helper()
+	select {
+	case <-c.(diam.CloseNotifier).CloseNotify():
+	case <-time.After(time.Second):
+		t.Fatal("CloseNotify did not report disconnection")
+	}
+}
+
+func TestSCTPWatchdogStream15(t *testing.T) {
+	machine := integrationMachine()
+	requests := make(chan *diam.Message, 16)
+	server := integrationServer(t, diam.HandlerFunc(func(c diam.Conn, m *diam.Message) {
+		machine.ServeDIAM(c, m)
+		if m.Header.CommandCode == diam.DeviceWatchdog {
+			select {
+			case requests <- m:
+			default:
+			}
+		}
+	}))
+	cli := integrationClient(true)
+	c, peer := integrationDial(t, cli, server)
+	defer server.release(peer)
+	// With zero retransmits, five distinct requests on one live association
+	// require four successful DWA deliveries to the automatic watchdog.
+	seen := make(map[uint32]bool)
+	until := time.After(2 * time.Second)
+	for len(seen) < 5 {
+		select {
+		case m := <-requests:
+			if m.MessageStream() != 15 {
+				t.Fatalf("watchdog stream=%d", m.MessageStream())
+			}
+			seen[m.Header.HopByHopID] = true
+		case <-c.(diam.CloseNotifier).CloseNotify():
+			t.Fatal("watchdog disconnected despite DWA responses")
+		case e := <-machine.ErrorReports():
+			t.Fatal(e)
+		case <-until:
+			t.Fatalf("only %d watchdog exchanges", len(seen))
+		}
+	}
+}
+
+func TestSCTPWatchdogAnswersPreserveStream(t *testing.T) {
+	machine := integrationMachine()
+	server := integrationServer(t, machine)
+	cli := integrationClient(false)
+	answers := make(chan *diam.Message, 4)
+	cli.Handler.HandleFunc("DWA", func(_ diam.Conn, m *diam.Message) { answers <- m })
+	c, peer := integrationDial(t, cli, server)
+	defer server.release(peer)
+	for _, stream := range []uint{0, 1, 15} {
+		request := diam.NewRequest(diam.DeviceWatchdog, 0, dict.Default)
+		request.NewAVP(avp.OriginHost, avp.Mbit, 0, datatype.DiameterIdentity("client"))
+		request.NewAVP(avp.OriginRealm, avp.Mbit, 0, datatype.DiameterIdentity("integration.test"))
+		if _, err := request.WriteToStream(c, stream); err != nil {
+			t.Fatal(err)
+		}
+		select {
+		case m := <-answers:
+			if m.MessageStream() != stream || m.Header.HopByHopID != request.Header.HopByHopID || m.Header.EndToEndID != request.Header.EndToEndID || !testResultCode(m, diam.Success) {
+				t.Fatalf("incorrect DWA stream=%d ids=%d/%d", m.MessageStream(), m.Header.HopByHopID, m.Header.EndToEndID)
+			}
+		case e := <-machine.ErrorReports():
+			t.Fatal(e)
+		case <-time.After(time.Second):
+			t.Fatal("no DWA")
+		}
+	}
+}
+
+func TestSCTPLargeMessagesAcrossStreams(t *testing.T) {
+	machine := integrationMachine()
+	errs := make(chan error, 8)
+	machine.HandleFunc("RAR", func(c diam.Conn, m *diam.Message) {
+		value, err := m.FindAVP(avp.UserName, 0)
+		if err != nil {
+			errs <- err
+			return
+		}
+		answer := m.Answer(diam.Success)
+		answer.AddAVP(value)
+		if _, err := answer.WriteTo(c); err != nil {
+			errs <- err
+		}
+	})
+	server := integrationServer(t, machine)
+	cli := integrationClient(false)
+	answers := make(chan *diam.Message, 3)
+	cli.Handler.HandleFunc("RAA", func(_ diam.Conn, m *diam.Message) { answers <- m })
+	c, peer := integrationDial(t, cli, server)
+	defer server.release(peer)
+	expected := make(map[uint32]struct {
+		stream  uint
+		payload []byte
+	})
+	sent := make(chan error, 3)
+	for _, stream := range []uint{0, 1, 15} {
+		payload := bytes.Repeat([]byte{byte('a' + stream)}, 128<<10)
+		request := diam.NewRequest(diam.ReAuth, 0, dict.Default)
+		request.NewAVP(avp.UserName, avp.Mbit, 0, datatype.UTF8String(payload))
+		expected[request.Header.HopByHopID] = struct {
+			stream  uint
+			payload []byte
+		}{stream, payload}
+		go func() { _, err := request.WriteToStream(c, stream); sent <- err }()
+	}
+	for range 3 {
+		select {
+		case err := <-sent:
+			if err != nil {
+				t.Fatal(err)
+			}
+		case <-time.After(3 * time.Second):
+			t.Fatal("large write stalled")
+		}
+	}
+	for range 3 {
+		select {
+		case m := <-answers:
+			want, ok := expected[m.Header.HopByHopID]
+			if !ok {
+				t.Fatal("unknown or duplicate answer")
+			}
+			delete(expected, m.Header.HopByHopID)
+			value, err := m.FindAVP(avp.UserName, 0)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if m.MessageStream() != want.stream || !testResultCode(m, diam.Success) || !bytes.Equal(value.Data.Serialize(), want.payload) {
+				t.Fatalf("payload/stream mismatch on stream %d", want.stream)
+			}
+		case err := <-errs:
+			t.Fatal(err)
+		case err := <-machine.ErrorReports():
+			t.Fatal(err)
+		case err := <-cli.Handler.ErrorReports():
+			t.Fatal(err)
+		case <-time.After(3 * time.Second):
+			t.Fatal("large message answer stalled")
+		}
+	}
+}
+
+func TestSCTPGracefulCloseDeliversQueuedAnswer(t *testing.T) {
+	machine := integrationMachine()
+	errs := make(chan error, 1)
+	machine.HandleFunc("RAR", func(c diam.Conn, m *diam.Message) {
+		if _, err := m.Answer(diam.Success).WriteTo(c); err != nil {
+			errs <- err
+			return
+		}
+		err := integrationShutdown(c.Connection().(*diam.SCTPConn), false)
+		if err != nil {
+			errs <- err
+		}
+	})
+	server := integrationServer(t, machine)
+	cli := integrationClient(false)
+	answers := make(chan *diam.Message, 1)
+	cli.Handler.HandleFunc("RAA", func(_ diam.Conn, m *diam.Message) { answers <- m })
+	c, peer := integrationDial(t, cli, server)
+	defer server.release(peer)
+	request := diam.NewRequest(diam.ReAuth, 0, dict.Default)
+	request.NewAVP(avp.UserName, avp.Mbit, 0, datatype.UTF8String("last request"))
+	if _, err := request.WriteTo(c); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case m := <-answers:
+		if !testResultCode(m, diam.Success) || m.Header.HopByHopID != request.Header.HopByHopID {
+			t.Fatal("incorrect last answer")
+		}
+	case err := <-errs:
+		t.Fatal(err)
+	case <-time.After(time.Second):
+		t.Fatal("queued answer lost during graceful shutdown")
+	}
+	integrationClosed(t, c)
+}
+
+func TestSCTPRecoveryCycles(t *testing.T) {
+	cycles := 12
+	if s := os.Getenv("DIAM_SCTP_RECOVERY_CYCLES"); s != "" {
+		n, err := strconv.Atoi(s)
+		if err != nil || n < 3 || n > 100000 {
+			t.Fatalf("invalid recovery cycle count %q", s)
+		}
+		cycles = n
+	}
+	machine := integrationMachine()
+	server := integrationServer(t, machine)
+	cli := integrationClient(false)
+	// Establish runtime/poller caches before measuring resource retention.
+	c, peer := integrationDial(t, cli, server)
+	c.Close()
+	integrationClosed(t, c)
+	server.release(peer)
+	resource := func() (int, int, uint64) {
+		runtime.GC()
+		fds, err := os.ReadDir("/proc/self/fd")
+		if err != nil {
+			t.Fatal(err)
+		}
+		var m runtime.MemStats
+		runtime.ReadMemStats(&m)
+		return len(fds), runtime.NumGoroutine(), m.HeapAlloc
+	}
+	baseFD, baseG, baseHeap := resource()
+	for i := 0; i < cycles; i++ {
+		// Do not register one cleanup closure per cycle: the harness owns all peers.
+		c, err := cli.DialExt("sctp4", server.Addr().String(), time.Second, nil)
+		if err != nil {
+			for _, reports := range []<-chan *diam.ErrorReport{cli.Handler.ErrorReports(), machine.ErrorReports()} {
+				for {
+					select {
+					case report := <-reports:
+						t.Logf("cycle failure report: %v", report.Error)
+					default:
+						goto drained
+					}
+				}
+			drained:
+			}
+			if counters, readErr := os.ReadFile("/proc/net/sctp/snmp"); readErr == nil {
+				t.Logf("SCTP counters:\n%s", counters)
+			}
+			t.Fatalf("cycle %d: %v", i, err)
+		}
+		var peer *diam.SCTPConn
+		select {
+		case p := <-server.accepted:
+			peer = p.(*diam.SCTPConn)
+		case <-time.After(time.Second):
+			c.Close()
+			t.Fatal("no recovery peer")
+		}
+		var closeErr error
+		switch i % 3 {
+		case 0:
+			c.Close()
+		case 1:
+			closeErr = integrationShutdown(peer, false)
+		case 2:
+			closeErr = integrationShutdown(peer, true)
+		}
+		if closeErr != nil {
+			c.Close()
+			t.Fatalf("cycle %d close: %v", i, closeErr)
+		}
+		integrationClosed(t, c)
+		c.Close()
+		server.release(peer)
+		if (i+1)%100 == 0 {
+			fd, g, heap := resource()
+			t.Logf("cycles=%d fds=%d goroutines=%d heap=%d", i+1, fd, g, heap)
+		}
+	}
+	until := time.Now().Add(2 * time.Second)
+	for {
+		fd, g, heap := resource()
+		if fd <= baseFD+1 && g <= baseG+3 {
+			// A finite cycle run is a leak screen, not the two-hour soak gate.
+			t.Logf("cycles=%d baseline=%d/%d/%d final=%d/%d/%d", cycles, baseFD, baseG, baseHeap, fd, g, heap)
+			if heap > baseHeap+4<<20 {
+				t.Fatalf("retained heap grew by %d bytes", heap-baseHeap)
+			}
+			return
+		}
+		if time.Now().After(until) {
+			t.Fatal(fmt.Errorf("resources did not settle: fd %d -> %d, goroutines %d -> %d", baseFD, fd, baseG, g))
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+}
+
+var _ net.Listener = (*integrationListener)(nil)
+
+// The business transport uses one-to-one SOCK_STREAM sockets. EOF sendmsg
+// controls are inapplicable there: use shutdown for graceful closure and
+// SO_LINGER(1,0)+close for an abortive peer, without changing kernel semantics.
+func integrationShutdown(c *diam.SCTPConn, abort bool) error {
+	raw, err := c.SyscallConn()
+	if err != nil {
+		return err
+	}
+	var opErr error
+	if err := raw.Control(func(fd uintptr) {
+		if abort {
+			opErr = syscall.SetsockoptLinger(int(fd), syscall.SOL_SOCKET, syscall.SO_LINGER, &syscall.Linger{Onoff: 1})
+		} else {
+			opErr = syscall.Shutdown(int(fd), syscall.SHUT_WR)
+		}
+	}); err != nil {
+		return err
+	}
+	if opErr != nil {
+		return opErr
+	}
+	if abort {
+		return c.Close()
+	}
+	return nil
+}
+
+func TestSCTPCloseNotifyAfterDisconnection(t *testing.T) {
+	machine := integrationMachine()
+	server := integrationServer(t, machine)
+	cli := integrationClient(false)
+	c, peer := integrationDial(t, cli, server)
+	defer server.release(peer)
+	// Wait for the read loop to process closure before the first subscription.
+	c.Close()
+	select {
+	case <-cli.Handler.ErrorReports():
+	case <-time.After(time.Second):
+		t.Fatal("read loop did not observe local close")
+	}
+	integrationClosed(t, c)
+}
