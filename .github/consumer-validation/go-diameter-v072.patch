+package sm
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"net"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/ctrlzy/go-diameter/v4/diam"
+	"github.com/ctrlzy/go-diameter/v4/diam/avp"
+	"github.com/ctrlzy/go-diameter/v4/diam/datatype"
+	"github.com/ctrlzy/go-diameter/v4/diam/dict"
+)
+
+// A response may be processed by a read goroutine before the transport write
+// returns. Execute that ordering synchronously so the regression is deterministic.
+type earlyReplyConn struct {
+	diam.Conn
+	client   *Client
+	mode     string
+	previous *diam.Message
+	done     chan struct{}
+	requests chan uint32
+	once     sync.Once
+	mu       sync.Mutex
+	ctx      context.Context
+}
+
+func (c *earlyReplyConn) Close()                       { c.once.Do(func() { close(c.done) }) }
+func (c *earlyReplyConn) CloseNotify() <-chan struct{} { return c.done }
+func (c *earlyReplyConn) Context() context.Context {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.ctx == nil {
+		return context.Background()
+	}
+	return c.ctx
+}
+func (c *earlyReplyConn) SetContext(ctx context.Context) { c.mu.Lock(); c.ctx = ctx; c.mu.Unlock() }
+func (c *earlyReplyConn) LocalAddr() net.Addr {
+	return &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 3868}
+}
+func (c *earlyReplyConn) RemoteAddr() net.Addr {
+	return &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 3869}
+}
+func (c *earlyReplyConn) CurrentWriterStream() uint   { return 0 }
+func (c *earlyReplyConn) ResetWriterStream()          {}
+func (c *earlyReplyConn) SetWriterStream(uint) uint   { return 0 }
+func (c *earlyReplyConn) Write(b []byte) (int, error) { return c.WriteStream(b, 0) }
+func (c *earlyReplyConn) WriteStream(b []byte, _ uint) (int, error) {
+	select {
+	case <-c.done:
+		return 0, net.ErrClosed
+	default:
+	}
+	request, err := diam.ReadMessage(bytes.NewReader(b), dict.Default)
+	if err != nil {
+		return 0, err
+	}
+	answer := request.Answer(diam.Success)
+	answer.NewAVP(avp.OriginHost, avp.Mbit, 0, datatype.DiameterIdentity("peer"))
+	answer.NewAVP(avp.OriginRealm, avp.Mbit, 0, datatype.DiameterIdentity("early.test"))
+	switch request.Header.CommandCode {
+	case diam.CapabilitiesExchange:
+		answer.NewAVP(avp.AcctApplicationID, avp.Mbit, 0, datatype.Unsigned32(3))
+		c.client.Handler.mux.ServeDIAM(c, answer)
+	case diam.DeviceWatchdog:
+		switch c.mode {
+		case "mismatched_end_only":
+			answer.Header.EndToEndID ^= 1
+			c.client.Handler.mux.ServeDIAM(c, answer)
+		case "late_previous":
+			if c.previous == nil {
+				c.client.Handler.mux.ServeDIAM(c, answer)
+			} else {
+				c.client.Handler.mux.ServeDIAM(c, c.previous)
+			}
+			c.previous = answer
+		case "duplicate_valid":
+			c.client.Handler.mux.ServeDIAM(c, answer)
+			c.client.Handler.mux.ServeDIAM(c, answer)
+		case "mismatched_only":
+			answer.Header.HopByHopID ^= 1
+			c.client.Handler.mux.ServeDIAM(c, answer)
+		case "other_connection":
+			other := &earlyReplyConn{ctx: c.Context()}
+			c.client.Handler.mux.ServeDIAM(other, answer)
+		case "noise_then_valid":
+			bad := request.Answer(diam.Success)
+			bad.Header.HopByHopID ^= 1
+			c.client.Handler.mux.ServeDIAM(c, bad)
+			c.client.Handler.mux.ServeDIAM(c, answer)
+		default:
+			c.client.Handler.mux.ServeDIAM(c, answer)
+		}
+		select {
+		case c.requests <- request.Header.HopByHopID:
+		default:
+		}
+	default:
+		return 0, errors.New("unexpected command")
+	}
+	return len(b), nil
+}
+func startEarlyReplyClient(t *testing.T, mode string) *earlyReplyConn {
+	t.Helper()
+	cli := &Client{Handler: New(&Settings{OriginHost: "client", OriginRealm: "early.test", VendorID: 13, ProductName: "test"}), Dict: dict.Default, EnableWatchdog: true, WatchdogInterval: 5 * time.Millisecond, RetransmitInterval: 20 * time.Millisecond, AcctApplicationID: []*diam.AVP{diam.NewAVP(avp.AcctApplicationID, avp.Mbit, 0, datatype.Unsigned32(3))}}
+	c := &earlyReplyConn{client: cli, mode: mode, done: make(chan struct{}), requests: make(chan uint32, 16)}
+	t.Cleanup(c.Close)
+	if err := cli.validate(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := cli.handshake(c); err != nil {
+		t.Fatal(err)
+	}
+	return c
+}
+func TestWatchdogKeepsReplyBeforeWriteReturns(t *testing.T) {
+	for _, mode := range []string{"valid", "noise_then_valid", "duplicate_valid"} {
+		t.Run(mode, func(t *testing.T) {
+			c := startEarlyReplyClient(t, mode)
+			ids := map[uint32]bool{}
+			guard := time.After(time.Second)
+			for len(ids) < 3 {
+				select {
+				case id := <-c.requests:
+					ids[id] = true
+				case <-c.done:
+					t.Fatal("valid DWA was lost before the sender began waiting")
+				case <-guard:
+					t.Fatal("watchdog did not advance after early DWA")
+				}
+			}
+		})
+	}
+}
+func TestWatchdogRejectsUnmatchedEarlyReplies(t *testing.T) {
+	for _, mode := range []string{"mismatched_only", "mismatched_end_only", "other_connection"} {
+		t.Run(mode, func(t *testing.T) {
+			c := startEarlyReplyClient(t, mode)
+			select {
+			case <-c.done:
+			case <-time.After(time.Second):
+				t.Fatal("unmatched DWA kept the association alive")
+			}
+		})
+	}
+}
+
+func TestWatchdogRejectsPreviousWindowReply(t *testing.T) {
+	c := startEarlyReplyClient(t, "late_previous")
+	select {
+	case <-c.done:
+	case <-time.After(time.Second):
+		t.Fatal("previous request's DWA acknowledged a new watchdog")
+	}
+	ids := make(map[uint32]bool)
+	for {
+		select {
+		case id := <-c.requests:
+			ids[id] = true
+		default:
+			if len(ids) != 2 {
+				t.Fatalf("completed %d requests, want one success followed by one timeout", len(ids))
+			}
+			return
+		}
+	}
+}
