@@ -0,0 +1,296 @@
+//go:build linux && !386 && !android
+
+package diam
+
+import (
+	"bytes"
+	"context"
+	"encoding/binary"
+	"errors"
+	"net"
+	"os"
+	"os/exec"
+	"syscall"
+	"testing"
+	"time"
+	"unsafe"
+
+	"github.com/skill215/sctp"
+)
+
+func upgradeListener(t *testing.T, drop bool) *sctp.SCTPListener {
+	t.Helper()
+	cfg := sctp.SocketConfig{InitMsg: sctp.InitMsg{NumOstreams: 16, MaxInstreams: 16}}
+	if drop {
+		cfg.Control = func(_, _ string, raw syscall.RawConn) error {
+			var e error
+			if err := raw.Control(func(fd uintptr) {
+				e = syscall.AttachLsf(int(fd), []syscall.SockFilter{{Code: syscall.BPF_RET | syscall.BPF_K, K: 0}})
+			}); err != nil {
+				return err
+			}
+			return e
+		}
+	}
+	ln, err := cfg.Listen("sctp4", &sctp.SCTPAddr{IPAddrs: []net.IPAddr{{IP: net.IPv4(127, 0, 0, 1)}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { ln.Close() })
+	return ln
+}
+
+// Decode kernel ancillary data independently of SCTPRead and the adapter.
+func TestSCTPUpgradeWirePPID(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		stream uint
+		write  func(MultistreamConn, []byte) (int, error)
+	}{
+		{"WriteDefault", 0, func(c MultistreamConn, b []byte) (int, error) { return c.Write(b) }},
+		{"WriteSelected", 3, func(c MultistreamConn, b []byte) (int, error) { c.SetWriterStream(3); return c.Write(b) }},
+		{"WriteStream", 1, func(c MultistreamConn, b []byte) (int, error) { return c.WriteStream(b, 1) }},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ln := upgradeListener(t, false)
+			rw, err := getMultistreamDialer("sctp4", time.Second, nil).Dial("sctp4", ln.Addr().String())
+			if err != nil {
+				t.Fatal(err)
+			}
+			t.Cleanup(func() { rw.Close() })
+			peer, err := ln.AcceptSCTP()
+			if err != nil {
+				t.Fatal(err)
+			}
+			t.Cleanup(func() { peer.Close() })
+			if err := peer.SubscribeEvents(sctp.SCTP_EVENT_DATA_IO); err != nil {
+				t.Fatal(err)
+			}
+			payload := []byte("Diameter independent PPID check")
+			n, err := tc.write(rw.(MultistreamConn), payload)
+			if err != nil || n != len(payload) {
+				t.Fatalf("write=%d,%v", n, err)
+			}
+			raw, err := peer.SyscallConn()
+			if err != nil {
+				t.Fatal(err)
+			}
+			var data [256]byte
+			var oob [256]byte
+			var on int
+			var recvErr error
+			until := time.Now().Add(time.Second)
+			for {
+				err = raw.Control(func(fd uintptr) {
+					n, on, _, _, recvErr = syscall.Recvmsg(int(fd), data[:], oob[:], syscall.MSG_DONTWAIT)
+				})
+				if err != nil {
+					t.Fatal(err)
+				}
+				if !errors.Is(recvErr, syscall.EAGAIN) {
+					break
+				}
+				if time.Now().After(until) {
+					t.Fatal("receive timed out")
+				}
+				time.Sleep(time.Millisecond)
+			}
+			if recvErr != nil {
+				t.Fatal(recvErr)
+			}
+			if !bytes.Equal(data[:n], payload) {
+				t.Fatalf("payload=%q", data[:n])
+			}
+			msgs, err := syscall.ParseSocketControlMessage(oob[:on])
+			if err != nil {
+				t.Fatal(err)
+			}
+			for _, m := range msgs {
+				if m.Header.Level == syscall.IPPROTO_SCTP && m.Header.Type == sctp.SCTP_CMSG_SNDRCV {
+					if len(m.Data) < 32 {
+						t.Fatal("short SCTP metadata")
+					}
+					if ppid := binary.BigEndian.Uint32(m.Data[8:12]); ppid != 46 {
+						t.Fatalf("wire PPID=%d (%x), want 46", ppid, m.Data[8:12])
+					}
+					if stream := binary.NativeEndian.Uint16(m.Data[:2]); uint(stream) != tc.stream {
+						t.Fatalf("stream=%d, want %d", stream, tc.stream)
+					}
+					return
+				}
+			}
+			t.Fatal("missing SCTP metadata")
+		})
+	}
+}
+
+// A subprocess bounds the regression even if the adapter drops its timeout.
+// The filter affects only this test socket; no firewall or namespace changes.
+func TestSCTPDialTimeoutBlackhole(t *testing.T) {
+	if mode := os.Getenv("DIAM_SCTP_TIMEOUT_CHILD"); mode != "" {
+		ln := upgradeListener(t, true)
+		var dialer Dialer = getMultistreamDialer("sctp4", 50*time.Millisecond, nil)
+		if mode == "single" {
+			dialer = getDialer("sctp4", 50*time.Millisecond, nil)
+		}
+		start := time.Now()
+		conn, err := dialer.Dial("sctp4", ln.Addr().String())
+		if conn != nil {
+			conn.Close()
+		}
+		if !errors.Is(err, os.ErrDeadlineExceeded) {
+			t.Fatalf("dial error=%v, want deadline exceeded", err)
+		}
+		var ne net.Error
+		if !errors.As(err, &ne) || !ne.Timeout() {
+			t.Fatalf("not a timeout: %v", err)
+		}
+		if elapsed := time.Since(start); elapsed < 25*time.Millisecond || elapsed > time.Second {
+			t.Fatalf("elapsed=%v", elapsed)
+		}
+		return
+	}
+	for _, mode := range []string{"single", "multi"} {
+		t.Run(mode, func(t *testing.T) {
+			ctx, cancel := context.WithTimeout(context.Background(), 4*time.Second)
+			defer cancel()
+			cmd := exec.CommandContext(ctx, os.Args[0], "-test.run=^TestSCTPDialTimeoutBlackhole$", "-test.v")
+			cmd.Env = append(os.Environ(), "DIAM_SCTP_TIMEOUT_CHILD="+mode)
+			output, err := cmd.CombinedOutput()
+			if err != nil {
+				t.Fatalf("timeout child: %v, context=%v\n%s", err, ctx.Err(), output)
+			}
+		})
+	}
+}
+
+func TestSCTPDialTimeoutDoesNotLeakIntoWrites(t *testing.T) {
+	for _, multi := range []bool{false, true} {
+		t.Run(map[bool]string{false: "single", true: "multi"}[multi], func(t *testing.T) {
+			ln := upgradeListener(t, false)
+			var d Dialer = getDialer("sctp4", 50*time.Millisecond, nil)
+			if multi {
+				d = getMultistreamDialer("sctp4", 50*time.Millisecond, nil)
+			}
+			c, err := d.Dial("sctp4", ln.Addr().String())
+			if err != nil {
+				t.Fatal(err)
+			}
+			t.Cleanup(func() { c.Close() })
+			peer, err := ln.AcceptSCTP()
+			if err != nil {
+				t.Fatal(err)
+			}
+			t.Cleanup(func() { peer.Close() })
+			var sc *sctp.SCTPConn
+			if multi {
+				sc = c.(*SCTPConn).SCTPConn
+			} else {
+				sc = c.(*sctp.SCTPConn)
+			}
+			raw, err := sc.SyscallConn()
+			if err != nil {
+				t.Fatal(err)
+			}
+			var value syscall.Timeval
+			size := uint32(unsafe.Sizeof(value))
+			var errno syscall.Errno
+			if err := raw.Control(func(fd uintptr) {
+				_, _, errno = syscall.Syscall6(syscall.SYS_GETSOCKOPT, fd, syscall.SOL_SOCKET, syscall.SO_SNDTIMEO, uintptr(unsafe.Pointer(&value)), uintptr(unsafe.Pointer(&size)), 0)
+			}); err != nil {
+				t.Fatal(err)
+			}
+			if errno != 0 {
+				t.Fatal(errno)
+			}
+			if value.Sec != 0 || value.Usec != 0 {
+				t.Fatalf("connect timeout leaked into writes: %+v", value)
+			}
+		})
+	}
+}
+
+func TestSCTPDialTimeoutPreservesRefusal(t *testing.T) {
+	ln := upgradeListener(t, false)
+	addr := ln.Addr().String()
+	ln.Close()
+	for _, d := range []Dialer{getDialer("sctp4", time.Second, nil), getMultistreamDialer("sctp4", time.Second, nil)} {
+		c, err := d.Dial("sctp4", addr)
+		if c != nil {
+			c.Close()
+		}
+		if !errors.Is(err, syscall.ECONNREFUSED) {
+			t.Fatalf("refusal=%v", err)
+		}
+	}
+}
+
+func TestSCTPDialNegativeTimeout(t *testing.T) {
+	ln := upgradeListener(t, false)
+	for _, d := range []Dialer{getDialer("sctp4", -time.Nanosecond, nil), getMultistreamDialer("sctp4", -time.Nanosecond, nil)} {
+		c, err := d.Dial("sctp4", ln.Addr().String())
+		if c != nil {
+			c.Close()
+		}
+		if !errors.Is(err, os.ErrDeadlineExceeded) {
+			t.Fatalf("negative timeout=%v", err)
+		}
+	}
+}
+
+func TestSCTPRejectsUnsupportedServerDeadline(t *testing.T) {
+	for _, op := range []string{"Read", "Write", "WriteStream"} {
+		t.Run(op, func(t *testing.T) {
+			ln := upgradeListener(t, false)
+			c, err := getMultistreamDialer("sctp4", time.Second, nil).Dial("sctp4", ln.Addr().String())
+			if err != nil {
+				t.Fatal(err)
+			}
+			t.Cleanup(func() { c.Close() })
+			peer, err := ln.AcceptSCTP()
+			if err != nil {
+				t.Fatal(err)
+			}
+			t.Cleanup(func() { peer.Close() })
+			dc, err := (&Server{ReadTimeout: time.Millisecond, WriteTimeout: time.Millisecond}).newConn(c)
+			if err != nil {
+				t.Fatal(err)
+			}
+			done := make(chan error, 1)
+			go func() {
+				var err error
+				switch op {
+				case "Read":
+					_, err = dc.readMessage()
+				case "Write":
+					_, err = dc.writer.Write([]byte("payload"))
+				case "WriteStream":
+					_, err = dc.writer.WriteStream([]byte("payload"), 1)
+				}
+				done <- err
+			}()
+			select {
+			case err := <-done:
+				if !errors.Is(err, syscall.EOPNOTSUPP) {
+					t.Fatalf("deadline error=%v", err)
+				}
+			case <-time.After(time.Second):
+				c.Close()
+				<-done
+				t.Fatal("unsupported deadline was ignored")
+			}
+			raw, err := peer.SyscallConn()
+			if err != nil {
+				t.Fatal(err)
+			}
+			var recvErr error
+			var buf [32]byte
+			if err := raw.Control(func(fd uintptr) { _, _, _, _, recvErr = syscall.Recvmsg(int(fd), buf[:], nil, syscall.MSG_DONTWAIT) }); err != nil {
+				t.Fatal(err)
+			}
+			if !errors.Is(recvErr, syscall.EAGAIN) {
+				t.Fatalf("unexpected data or close after rejected operation: %v", recvErr)
+			}
+		})
+	}
+}
